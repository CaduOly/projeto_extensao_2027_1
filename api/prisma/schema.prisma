datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model Alert {
  id          Int      @id @default(autoincrement())
  description String   @db.Text
  latitude    Float
  longitude   Float
  photo       String?  @db.LongText // Armazena a string Base64 da imagem
  type        String   // 'DISPOSAL' (descarte irregular) ou 'RECYCLING' (ponto de reciclagem)
  createdAt   DateTime @default(now())
}
